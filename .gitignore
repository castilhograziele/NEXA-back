# ============================================================
# Laravel — .gitignore
# ============================================================

# --- Ambiente e segredos ---
.env
.env.backup
.env.production
.env.*.local
auth.json

# --- Dependências ---
/vendor
/node_modules

# --- Build e cache ---
/public/build
/public/hot
/bootstrap/cache/*.php
/.phpunit.cache
.phpunit.result.cache

# --- Storage (gerado em runtime) ---
/storage/*.key
/storage/pail
/storage/logs/*
/storage/framework/cache/*
/storage/framework/sessions/*
/storage/framework/views/*
/storage/app/public/*         # uploads de imagens (futura feature)

# --- IDEs e editores ---
/.idea
/.vscode
/.fleet
/.nova
/.zed
.phpactor.json

# --- Sistema operacional ---
.DS_Store
Thumbs.db
*.log

# --- Laravel Homestead (dev local) ---
Homestead.json
Homestead.yaml

# --- Scribe (documentação gerada automaticamente) ---
/.scribe/endpoints.cache
/public/vendor/scribe
/storage/app/private/scribe

# --- Arquivos que nunca devem existir no repo ---
*.pem
*.key
*.p12
/public/storage
